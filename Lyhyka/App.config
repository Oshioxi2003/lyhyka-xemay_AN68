    <add key="Hand_RBrake_Result" value="" />
    <add key="Front_LWeight_Result" value="" />
    <add key="Front_RWeight_Result" value="" />
    <add key="Rear_LWeight_Result" value="" />
    <add key="Rear_RWeight_Result" value="" />
    <add key="Calib_SS" value="" />
    <add key="Calib_LBrake" value="" />
    <add key="Calib_RBrake" value="" />
    <add key="Calib_LWeight" value="" />
    <add key="Calib_RWeight" value="" />
    <add key="Calib_Speed" value="" />
    <add key="OPC_SetAuto" value="" />
    <add key="OPC_Start" value="" />
    <add key="OPC_Stop" value="" />
    <add key="OPC_Motor" value="" />
    <add key="OPC_LeftDistance" value="" />
    <add key="OPC_RightDistance" value="" />
    <add key="OPC_SetLeft" value="" />
    <add key="OPC_SetRight" value="" />
    <add key="OPC_ConfirmDistance" value="" />
