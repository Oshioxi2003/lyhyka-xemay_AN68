    <add key="OPC_IncreaseRight" value="" />
    <add key="OPC_DecreaseLeft" value="" />
    <add key="OPC_DecreaseRight" value="" />
    <add key="PublishSeri" value="" />
    <add key="PublishVer" value="" />
    <add key="PublishDate" value="" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="Distance1Name" value="" />
    <add key="Distance1Value" value="" />
    <add key="Distance2Name" value="" />
    <add key="Distance2Value" value="" />
    <add key="Distance3Name" value="" />
    <add key="Distance3Value" value="" />
    <add key="Distance4Name" value="" />
    <add key="Distance4Value" value="" />
